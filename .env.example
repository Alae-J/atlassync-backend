# Copy this file to `.env` (already gitignored) and fill in real values.
# docker-compose automatically loads `.env` for variable substitution.
#
# Stripe test-mode keys — get them from:
#   https://dashboard.stripe.com/test/apikeys
# The webhook secret comes from `stripe listen --forward-to ...` output.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
