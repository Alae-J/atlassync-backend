# Copy to .env.prod on the server and fill in real values (never commit .env.prod).
#   cp .env.prod.example .env.prod && nano .env.prod

# Postgres (internal-only; still pick a strong password)
POSTGRES_USER=atlassync
POSTGRES_PASSWORD=replace-with-strong-password

# Shared across gateway, auth-service, session-service. 64+ random chars.
#   generate: openssl rand -hex 48
JWT_SECRET=replace-with-64-char-random-secret

# Vault dev-mode root token (in-memory; reseeded by vault-init on every up)
VAULT_TOKEN=root

# Stripe TEST keys (https://dashboard.stripe.com/test/apikeys).
# Webhook secret comes from a Stripe webhook endpoint pointed at
#   https://atlassync.alae-j.me/api/sessions/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=mad

# OTP delivery: log (codes printed to auth-service logs) | brevo | smsgate | whatsapp
OTP_DELIVERY_PROVIDER=log
